  @Builder
  BookListItem(book: Book) {
    Row() {
      if (book.coverPath) {
        Image(BookService.getCoverUrl(book.id))
          .width(56)
          .height(76)
          .objectFit(ImageFit.Cover)
          .borderRadius(6)
      } else {
        Column() {
          Text(book.title)
            .fontSize(11)
            .fontColor('#FFFFFF')
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .textAlign(TextAlign.Center)
        }
        .width(56)
        .height(76)
        .linearGradient({
          direction: GradientDirection.RightBottom,
          colors: [['#007DFF', 0.0], ['#0052CC', 1.0]]
        })
        .borderRadius(6)
        .justifyContent(FlexAlign.Center)
        .alignItems(HorizontalAlign.Center)
        .padding(4)
      }

      Column() {
        Text(book.title)
          .fontSize(14)
          .fontColor('#181818')
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })

        Text(book.author || 'æœªçŸ¥ä½œè€…')
          .fontSize(12)
          .fontColor('#999999')
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .margin({ top: 4 })

        Row() {
          Text(book.format.toUpperCase())
            .fontSize(10)
            .fontColor('#FFFFFF')
            .backgroundColor(book.format === 'pdf' ? '#FA2A2D' : book.format === 'epub' ? '#45A848' : '#F5A623')
            .borderRadius(4)
            .padding({ left: 4, right: 4, top: 2, bottom: 2 })

          if (book.readingProgress) {
            Text(`${Math.round(book.readingProgress.percentage * 100)}%`)
              .fontSize(11)
              .fontColor('#999999')
              .margin({ left: 8 })
          }
        }
        .margin({ top: 4 })
      }
      .layoutWeight(1)
      .padding({ left: 12 })
      .alignItems(HorizontalAlign.Start)
    }
    .width('100%')
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .padding(8)
    .margin({ bottom: 8 })
    .shadow({ radius: 8, color: '#10000000', offsetY: 2 })
    .onClick(() => {
      let p = new NavParams(); p.bookId = book.id; navigateTo(this.getUIContext(), 'pages/BookDetailPage', p)
