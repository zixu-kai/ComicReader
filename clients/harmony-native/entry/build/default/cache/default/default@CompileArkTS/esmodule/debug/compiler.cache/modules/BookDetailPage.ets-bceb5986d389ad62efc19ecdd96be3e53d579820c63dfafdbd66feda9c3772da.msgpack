    getFormatLabel(format) {
        switch (format) {
            case 'pdf':
                return 'PDF';
            case 'epub':
                return 'EPUB';
            case 'txt':
                return 'TXT';
            default:
                return format.toUpperCase();
        }
    }
    getFormatColor(format) {
        switch (format) {
            case 'pdf':
                return '#EF4444';
            case 'epub':
                return '#22C55E';
            case 'txt':
                return '#F59E0B';
            default:
                return '#9CA3AF';
        }
    }
