//# sourceMappingURL=CategoriesPage.js.mapÂ’ÙYD:\GongZuo\ComicReader\clients\harmony-native\entry\src\main\ets\service\ComicService.etsÙUD:\GongZuo\ComicReader\clients\harmony-native\entry\src\main\ets\common\Constants.etsÙYD:\GongZuo\ComicReader\clients\harmony-native\entry\src\main\ets\pages\CategoriesPage.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ3D:\GongZuo\ComicReader\clients\harmony-native\entryÙ-D:\GongZuo\ComicReader\clients\harmony-native¥entry¥1.0.0Ô␀␀Ù3D:\GongZuo\ComicReader\clients\harmony-native\entryÃÃÚ8import { Category, Tag } from '../model/ComicModels'
import { CategoryService, TagService } from '../service/ComicService'
import { navigateToTab } from '../common/Constants'

@Entry
@Component
struct CategoriesPage {
  @State categories: Category[] = []
  @State tags: Tag[] = []
  @State currentTab: number = 0
  @State showAddCategoryDialog: boolean = false
  @State showAddTagDialog: boolean = false
  @State showDeleteConfirmDialog: boolean = false
  @State deleteType: string = ''
  @State deleteId: number = 0
  @State deleteName: string = ''
  @State newCategoryName: string = ''
  @State newCategoryDescription: string = ''
  @State newTagName: string = ''

  aboutToAppear(): void {
    this.loadCategories()
    this.loadTags()
  }

  async loadCategories(): Promise<void> {
    try {
      this.categories = await CategoryService.getCategories()
    } catch (e) {
      console.error('Failed to load categories: ' + JSON.stringify(e))
    }
  }

  async loadTags(): Promise<void> {
    try {
      this.tags = await TagService.getTags()
    } catch (e) {
      console.error('Failed to load tags: ' + JSON.stringify(e))
    }
  }

  async createCategory(): Promise<void> {
    if (!this.newCategoryName.trim()) {
      return
    }
    try {
      await CategoryService.createCategory(this.newCategoryName.trim(), this.newCategoryDescription.trim() || undefined)
      this.showAddCategoryDialog = false
      this.newCategoryName = ''
      this.newCategoryDescription = ''
      this.loadCategories()
    } catch (e) {
      console.error('Failed to create category: ' + JSON.stringify(e))
    }
  }

  async createTag(): Promise<void> {
    if (!this.newTagName.trim()) {
      return
    }
    try {
      await TagService.createTag(this.newTagName.trim())
      this.showAddTagDialog = false
      this.newTagName = ''
      this.loadTags()
    } catch (e) {
      console.error('Failed to create tag: ' + JSON.stringify(e))
    }
  }

  async confirmDelete(): Promise<void> {
    try {
      if (this.deleteType === 'category') {
        await CategoryService.deleteCategory(this.deleteId)
        this.loadCategories()
      } else {
        await TagService.deleteTag(this.deleteId)
        this.loadTags()
      }
      this.showDeleteConfirmDialog = false
    } catch (e) {
      console.error('Failed to delete: ' + JSON.stringify(e))
    }
  }

  build() {
    Column() {
      Row() {
        Image($r('sys.media.ohos_ic_public_arrow_left'))
          .width(24)
          .height(24)
          .fillColor('#181818')
          .onClick(() => {
            try { navigateToTab(this.getUIContext(), 'pages/HomePage') } catch (e) { console.error('Back failed: ' + JSON.stringify(e)) }
          })

        Text('åˆ†ç±»ä¸æ ‡ç­¾')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#181818')
          .layoutWeight(1)
          .textAlign(TextAlign.Center)

        Row()
          .width(24)
          .height(24)
      }
      .width('100%')
      .height(56)
      .padding({ left: 16, right: 16 })
      .alignItems(VerticalAlign.Center)
      .backgroundColor('#FFFFFF')

      Tabs({ index: this.currentTab }) {
        TabContent() {
          this.CategoryTab()
        }
        .tabBar('åˆ†ç±»ç®¡ç†')

        TabContent() {
          this.TagTab()
        }
        .tabBar('æ ‡ç­¾ç®¡ç†')
      }
      .layoutWeight(1)
      .width('100%')
      .barMode(BarMode.Fixed)
      .barBackgroundColor('#FFFFFF')
      .animationDuration(0)
      .onChange((index: number) => {
        this.currentTab = index
      })

      if (this.showAddCategoryDialog) {
        this.AddCategoryDialog()
      }

      if (this.showAddTagDialog) {
        this.AddTagDialog()
      }

      if (this.showDeleteConfirmDialog) {
        this.DeleteConfirmDialog()
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F1F3F5')
  }

  @Builder
  CategoryTab() {
    Column() {
      Row() {
        Text(`å…± ${this.categories.length} ä¸ªåˆ†ç±»`)
          .fontSize(13)
          .fontColor('#999999')

        Blank()

        Button('æ–°å¢åˆ†ç±»')
          .height(32)
          .fontSize(13)
          .fontColor('#FFFFFF')
          .backgroundColor('#007DFF')
          .borderRadius(16)
          .padding({ left: 12, right: 12 })
          .onClick(() => {
            this.newCategoryName = ''
            this.newCategoryDescription = ''
            this.showAddCategoryDialog = true
          })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 12, bottom: 8 })

      if (this.categories.length === 0) {
        Column() {
          Text('æš‚æ— åˆ†ç±»')
            .fontSize(14)
            .fontColor('#CCCCCC')
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
        .alignItems(HorizontalAlign.Center)
      } else {
        List() {
          ForEach(this.categories, (category: Category) => {
            ListItem() {
              Row() {
                Column() {
                  Text(category.name)
                    .fontSize(15)
                    .fontColor('#181818')
                    .maxLines(1)
                    .textOverflow({ overflow: TextOverflow.Ellipsis })

                  if (category.description) {
                    Text(category.description)
                      .fontSize(12)
                      .fontColor('#999999')
