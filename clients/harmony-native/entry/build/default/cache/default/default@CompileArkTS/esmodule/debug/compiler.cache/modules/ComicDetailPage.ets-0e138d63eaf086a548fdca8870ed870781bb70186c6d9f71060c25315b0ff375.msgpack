          .width('100%')
        }

        if (this.comic!.tags && this.comic!.tags.length > 0) {
          Text('æ ‡ç­¾')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor('#E5E7EB')
            .width('100%')
            .margin({ bottom: 8, top: this.comic!.categories.length > 0 ? 12 : 0 })

          Flex({ wrap: FlexWrap.Wrap }) {
            ForEach(this.comic!.tags, (tag: Tag) => {
              Text(tag.name)
                .fontSize(13)
                .fontColor('#A78BFA')
                .backgroundColor('#2E1065')
                .borderRadius(16)
                .padding({ left: 12, right: 12, top: 6, bottom: 6 })
                .margin({ right: 8, bottom: 8 })
                .onClick(() => {
                  let p = new NavParams(); p.tagId = tag.id; navigateTo(this.getUIContext(), 'pages/LibraryPage', p)
                })
            })
          }
          .width('100%')
        }
      }
      .width('100%')
      .padding(16)
      .backgroundColor('#1F2937')
      .borderRadius(12)
      .margin({ top: 12 })
    }
  }

  @Builder
  ChapterList() {
    if (this.chapters.length > 0) {
      Column() {
        Text(`ç« èŠ‚ (${this.chapters.length})`)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor('#E5E7EB')
          .width('100%')
          .margin({ bottom: 12 })

        Grid() {
          ForEach(this.chapters, (chapter: Chapter) => {
            GridItem() {
              Column() {
                Text(chapter.title || `ç¬¬${chapter.chapterNumber}è¯`)
                  .fontSize(13)
                  .fontColor(chapter.id === this.currentChapterId ? '#6366F1' : '#E5E7EB')
                  .maxLines(1)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })
                  .width('100%')

                if (chapter.pageCount > 0) {
                  Text(`${chapter.pageCount}é¡µ`)
                    .fontSize(11)
                    .fontColor('#9CA3AF')
                    .width('100%')
                    .margin({ top: 2 })
                }
              }
              .width('100%')
              .padding(10)
              .backgroundColor(chapter.id === this.currentChapterId ? '#312E81' : '#374151')
              .borderRadius(8)
              .border(chapter.id === this.currentChapterId ? {
                width: 1,
                color: '#6366F1'
              } : undefined)
              .onClick(() => {
                this.onReadChapter(chapter.id)
              })
            }
            .padding(4)
          })
        }
        .columnsTemplate('1fr 1fr 1fr')
        .rowsGap(4)
        .columnsGap(4)
        .width('100%')
      }
      .width('100%')
      .padding(16)
      .backgroundColor('#1F2937')
      .borderRadius(12)
      .margin({ top: 12 })
    }
  }

