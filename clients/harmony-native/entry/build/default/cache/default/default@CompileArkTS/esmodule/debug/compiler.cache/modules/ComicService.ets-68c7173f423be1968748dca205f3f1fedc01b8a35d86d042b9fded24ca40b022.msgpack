import { ProgressUpdateRequest, RatingRequest, CreateNoteRequest, CreateBookmarkRequest, CreateCategoryRequest, CreateTagRequest, AddToBookmarkRequest, AddBookToBookmarkRequest } from '../model/ComicModels';
export class ComicService {
    static async getComics(params) {
        const res = await api.get('/api/comics', { params: params });
        return res.data;
    }
    static async getComic(id) {
        const res = await api.get(`/api/comics/${id}`);
        return res.data;
    }
    static async updateComic(id, data) {
        const res = await api.put(`/api/comics/${id}`, data);
        return res.data;
    }
    static async deleteComic(id) {
        await api.delete(`/api/comics/${id}`);
    }
    static async scan() {
        const res = await api.post('/api/comics/scan', null);
        return res.data;
    }
    static async getRandomComics(count) {
        const params = {};
        if (count)
            params['count'] = count.toString();
        const res = await api.get('/api/comics/random', { params: params });
        return res.data;
    }
    static async searchComics(query) {
        const res = await api.get(`/api/comics/search`, { params: { query: query } });
        return res.data;
    }
    static async getChapters(comicId) {
        const res = await api.get(`/api/comics/${comicId}/chapters`);
        return res.data;
    }
    static async getChapterPages(chapterId) {
        const res = await api.get(`/api/chapters/${chapterId}/pages`);
        return res.data;
    }
    static getCoverUrl(id) {
        return `${api.defaults.baseURL}/api/comics/${id}/cover`;
    }
    static getPageImageUrl(chapterId, pageNum) {
        return `${api.defaults.baseURL}/api/chapters/${chapterId}/pages/${pageNum}`;
    }
    static async getProgress(comicId) {
        const res = await api.get(`/api/comics/${comicId}/progress`);
        return res.data;
    }
    static async updateProgress(comicId, chapterId, currentPage, totalPages) {
        const body = new ProgressUpdateRequest();
        body.chapterId = chapterId;
        body.currentPage = currentPage;
        body.totalPages = totalPages;
        await api.put(`/api/comics/${comicId}/progress`, body);
    }
    static async markCompleted(comicId) {
        await api.put(`/api/comics/${comicId}/progress/complete`, null);
    }
    static async getContinueReading() {
        const res = await api.get('/api/progress/continue');
        return res.data;
    }
    static async getRating(comicId) {
        const res = await api.get(`/api/comics/${comicId}/rating`);
        return res.data;
    }
    static async setRating(comicId, score, readingStatus, notes) {
        const body = new RatingRequest();
        body.score = score;
        body.readingStatus = readingStatus;
        if (notes)
            body.notes = notes;
        await api.put(`/api/comics/${comicId}/rating`, body);
    }
}
