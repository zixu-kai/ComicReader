        config.signal.aborted ? abort() : config.signal.addEventListener('abort', abort);
    }
    httpRequest.request(
        // å¡«å†™httpè¯·æ±‚çš„urlåœ°å€ï¼Œå¯ä»¥å¸¦å‚æ•°ä¹Ÿå¯ä»¥ä¸å¸¦å‚æ•°ã€‚URLåœ°å€éœ€è¦å¼€å‘è€…è‡ªå®šä¹‰ã€‚GETè¯·æ±‚çš„å‚æ•°å¯ä»¥åœ¨extraDataä¸­æŒ‡å®š
