const setCertificate = (config, options) => {
    // è®¾ç½®caPath
    if (config.caPath) {
        options.caPath = config.caPath;
    }

    // è®¾ç½®sslType
    if (config.sslType) {
        let apiVersion = deviceInfo.sdkApiVersion;
        if (config.sslType === 'TLCP' && apiVersion < 20) {
