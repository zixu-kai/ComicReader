# 服务配置
PORT=7788
HOST=0.0.0.0
NODE_ENV=production

# 路径配置
COMICS_DIR=./comics
DB_PATH=./data/ownshelf.db
COVERS_DIR=./data/covers
DATA_DIR=./data

# 安全
JWT_SECRET=change-me-in-production

# 可选：开启访问密码（生产环境建议开启）
# AUTH_ENABLED=true
# AUTH_PASSWORD=your-password

# 自动扫描间隔（毫秒，默认 5 分钟）
SCAN_INTERVAL=300000

# 用户权限（Docker 部署时使用，本地开发忽略）
PUID=1000
PGID=100